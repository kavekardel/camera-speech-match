{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SttGateway": {
    "BaseUrl": "https://ai-stt-gateway.airparsiana.com",
    "ConnectTimeoutSeconds": 10,
    "MaximumEventBytes": 65536
  },
  "SpeechInput": {
    "Enabled": true,
    "ReadyTimeoutSeconds": 15,
    "FinalizationTimeoutSeconds": 6,
    "MaximumSessionSeconds": 300,
    "MaximumAudioBytes": 10485760
  },
  "SystemOne": {
    "Enabled": true,
    "TimeoutSeconds": 35,
    "MaxRequestBytes": 65536,
    "MaxResponseBytes": 262144
  }
}
